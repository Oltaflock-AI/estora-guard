# ============================================
# Estora Guard -- Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.


# ----- Supabase -----
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key -- server-side only, bypasses RLS
# Get from: Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Anthropic (Claude AI) -----
# Get from: https://console.anthropic.com/settings/keys
# Used by document extraction and the draft_next_actions agent skill
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# ----- LlamaParse (PDF pre-processing) -----
# Get from: https://cloud.llamaindex.ai/api-key
# Optional — system falls back to direct Claude PDF extraction if unavailable
LLAMA_CLOUD_API_KEY=llx-xxxxxxxxxxxxxxxxxx

# ----- Cron / Background Jobs -----
# Random secret to authenticate the /api/cron/check-deadlines endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-256-bit-hex-string

# ----- App Config -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Supabase Storage -----
# Storage bucket name for uploaded PDFs (created automatically)
NEXT_PUBLIC_STORAGE_BUCKET=documents
